# Frontend (Vite) - used at build time
VITE_API_BASE=/api

# Setup password for the /admin-create-account page.
# Keep both values the same. The frontend reads the VITE_ one to gate the page;
# the backend (api/create-admin.php) verifies the plain one from the server env.
VITE_ADMIN_SETUP_PASSWORD=
ADMIN_SETUP_PASSWORD=

# Backend (PHP) - used at runtime on Awardspace
# Set these as environment variables in your Awardspace hosting control panel
DB_HOST=localhost
DB_NAME=francis_key
DB_USER=your_database_user
DB_PASS=your_database_password