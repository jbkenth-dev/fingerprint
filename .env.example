# Frontend (Vite) - used at build time
VITE_API_BASE=/api

# Setup password for the /admin-create-account page.
# ONE value used by BOTH the frontend (import.meta.env) and the backend
# (api/create-admin.php reads getenv('VITE_ADMIN_SETUP_PASSWORD')).
# Set this in your Vercel env AND on the backend host (Awardspace).
VITE_ADMIN_SETUP_PASSWORD=

# Backend (PHP) - used at runtime on Awardspace
# Set these as environment variables in your Awardspace hosting control panel
DB_HOST=localhost
DB_NAME=francis_key
DB_USER=your_database_user
DB_PASS=your_database_password

# Optional: enable only if your PHP host supports persistent PDO connections.
DB_PERSISTENT=false
# Shared pause after MySQL reports an exhausted hourly allowance (seconds).
DB_LIMIT_RETRY_SECONDS=300
# Optional writable directory outside the web root; defaults to PHP's temp directory.
# DB_COOLDOWN_DIR=/private/writable/path
