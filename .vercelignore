# Vercel ignore file
# Keep only what's needed for deployment:
# - api/ (serverless functions)
# - public/ (static assets)
# - src/ (source for build)
# - dist/ (build output)
# - index.html
# - vercel.json
# - package.json + package-lock.json
# - vite.config.js

# Exclude files not needed for deployment
arduino/
create_db.sql
scripts/
.vscode-upload.json
.git/
.gitignore
README.md
*.md
.env.example

# Local dependencies, generated output, and private configuration are not source uploads.
/node_modules/
/dist/
/.vercel/
/.env*
/.attendance-build-check/
/memory/
/docs/
/check_db.php
